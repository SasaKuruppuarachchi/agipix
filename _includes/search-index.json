{%- comment -%}
  Search index for the Ctrl/Cmd+K palette, generated by Liquid on every build so it
  can't go stale. One entry per page: intro text plus every h2/h3 section as
  [id, heading, text]. Top-level pages render after the docs/ folders, so
  d.content is already HTML here (Markdown is converted as a fallback).
{%- endcomment -%}
{%- include docs-order.html -%}
{%- assign _hub = site.pages | where: "url", doc_root -%}
{%- assign _bom = site.pages | where: "url", "/bom.html" -%}
{%- assign _bench = site.pages | where: "url", "/benchmark.html" -%}
{%- assign _items = _hub | concat: docs_ordered | concat: _bom | concat: _bench -%}
[
{%- for d in _items -%}
  {%- if d.content contains '<h1 id="' or d.content contains '<h2 id="' -%}{%- assign _html = d.content -%}{%- else -%}{%- assign _html = d.content | markdownify -%}{%- endif -%}
  {%- assign _html = _html | replace: '<h3 id="', '<h2 id="' | replace: '</h3>', '</h2>' -%}
  {%- assign _parts = _html | split: '<h2 id="' -%}
  {%- assign _segs = d.path | remove_first: doc_src | split: "/" -%}
  {%- assign _label = "Resources" -%}
  {%- if d.path contains doc_src and _segs.size > 1 -%}
    {%- assign _sec = site.data.docs.sections | where: "key", _segs[0] | first -%}{%- assign _label = _sec.title -%}
  {%- elsif d.path contains doc_src -%}{%- assign _label = "Docs" -%}{%- endif -%}
{
"title": {{ d.nav_title | default: d.title | strip | jsonify }},
"url": {{ d.url | relative_url | jsonify }},
"section": {{ _label | jsonify }},
"text": {{ _parts[0] | strip_html | normalize_whitespace | jsonify }},
"h": [
  {%- for _part in _parts offset: 1 -%}
    {%- assign _sid = _part | split: '"' | first -%}
    {%- assign _hp = _part | split: '</h2>' | first -%}
    {%- assign _ht = _hp | remove_first: _sid | remove_first: '">' | strip_html | normalize_whitespace -%}
    {%- assign _body = _part | remove_first: _hp | remove_first: '</h2>' | strip_html | normalize_whitespace -%}
  [{{ _sid | jsonify }}, {{ _ht | jsonify }}, {{ _body | jsonify }}]{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
